{
  "extraKnownMarketplaces": {
    "classvr-prototypes": {
      "source": {
        "source": "github",
        "repo": "ClassVR-Prototypes/classvr-prototyping-kit"
      }
    }
  },
  "enabledPlugins": {
    "classvr-prototyping-kit@classvr-prototypes": true
  },
  "permissions": {
    "allow": [
      "Bash(python3 *classvr-prototyping-kit/*)",
      "Bash(python *classvr-prototyping-kit/*)",
      "Bash(sh ./update-kit.sh*)",
      "Bash(./update-kit.sh*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git merge *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git submodule *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git remote *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(git mv *)",
      "Bash(git rm *)",
      "Bash(gh pr *)",
      "Bash(gh api *)",
      "Bash(curl *api.github.com*)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(ls *)",
      "Bash(cat *)"
